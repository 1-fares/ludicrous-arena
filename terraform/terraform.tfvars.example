# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
region         = "ap-southeast-1"
project_prefix = "arena"

# Built by scripts/package-fc.sh (run it before the first apply).
function_zip = "../backend/build/fc.zip"

# Custom domain (Phase 2). Leave empty to skip.
# domain_name = "ludicrous-arena.com"
# cert_path   = "/path/to/fullchain.pem"
# key_path    = "/path/to/key.pk8.pem"

# Tuning (optional):
# function_memory  = 512
# function_timeout = 60
